{
  "lsp": {
    "gopls": {
      "initialization_options": {
        "buildFlags": ["-tags=integration"]
      }
    }
  },
  "languages": {
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
        "..."
      ]
    }
