scalar Time

type Device {
  id: ID!
  deviceKey: String!
  displayName: String!
  createdAt: Time!
}

type DeviceEdge {
  cursor: String!
  node: Device!
}

type PageInfo {
  endCursor: String
  hasNextPage: Boolean!
}

type DeviceConnection {
  edges: [DeviceEdge!]!
  pageInfo: PageInfo!
}

type DeviceCurrentState {
  messageId: ID!
  observedAt: Time!
  receivedAt: Time!
  temperatureCelsius: Float!
  lastSeenAt: Time!
}

type TelemetryPoint {
  messageId: ID!
  observedAt: Time!
  receivedAt: Time!
  temperatureCelsius: Float!
}

type TelemetryEdge {
  cursor: String!
  node: TelemetryPoint!
}

type TelemetryConnection {
  edges: [TelemetryEdge!]!
  pageInfo: PageInfo!
}

input CreateDeviceInput {
  deviceKey: String!
  displayName: String!
}

type Query {
  device(id: ID!): Device
  devices(first: Int! = 20, after: String): DeviceConnection!
  deviceCurrentState(deviceId: ID!): DeviceCurrentState
  deviceTelemetry(deviceId: ID!, first: Int! = 50, after: String): TelemetryConnection!
}

type Mutation {
  createDevice(input: CreateDeviceInput!): Device!
}
