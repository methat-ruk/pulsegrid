# Production values must be injected by the runtime or secret manager.
PULSEGRID_ENV=production
PULSEGRID_HTTP_HOST=
PULSEGRID_HTTP_PORT=
PULSEGRID_LOG_LEVEL=info
PULSEGRID_SHUTDOWN_TIMEOUT=15s

# Inject from the deployment secret manager when a production database
# consumer is introduced. Never store a production URL in this file.
PULSEGRID_DATABASE_URL=
