# Select development, test, or production explicitly before starting the API.
PULSEGRID_ENV=development
PULSEGRID_HTTP_HOST=127.0.0.1
PULSEGRID_HTTP_PORT=8080
PULSEGRID_LOG_LEVEL=info
PULSEGRID_SHUTDOWN_TIMEOUT=10s
PULSEGRID_IDENTITY_MODE=development

# Development mode exposes the fixed pulsegrid-dev GraphQL identity and
# requires the seeded local database; replace CHANGE_ME only in the ignored
# local file. Disabled/health-only mode does not require this URL, but
# development GraphQL startup does.
# Do not commit a real password.
PULSEGRID_DATABASE_URL=postgres://pulsegrid:CHANGE_ME@127.0.0.1:5432/pulsegrid_dev?sslmode=disable
