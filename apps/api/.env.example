# Select development, test, or production explicitly before starting the API.
PULSEGRID_ENV=development
PULSEGRID_HTTP_HOST=127.0.0.1
PULSEGRID_HTTP_PORT=8080
PULSEGRID_LOG_LEVEL=info
PULSEGRID_SHUTDOWN_TIMEOUT=10s
PULSEGRID_IDENTITY_MODE=development

# Planned MVP-005 API ingestion switch. Keep disabled until the ingestion
# consumer is implemented; development will require the loopback broker and
# local database configured below.
PULSEGRID_MQTT_INGESTION_MODE=disabled

# Development mode exposes the fixed pulsegrid-dev GraphQL identity and
# requires the seeded local database; replace CHANGE_ME only in the ignored
# local file. Disabled/health-only mode does not require this URL, but
# development GraphQL startup does.
# Do not commit a real password.
PULSEGRID_DATABASE_URL=postgres://pulsegrid:CHANGE_ME@127.0.0.1:5432/pulsegrid_dev?sslmode=disable

# The broker URL is used by the MVP-004 simulator and will also be consumed by
# the API when MVP-005 ingestion is implemented and enabled. The tenant, device,
# and temperature values remain simulator-only. Copy a canonical lowercase
# device UUID from the registered-device journey into the ignored local file.
PULSEGRID_MQTT_BROKER_URL=mqtt://127.0.0.1:1883
PULSEGRID_MQTT_TENANT_SLUG=pulsegrid-dev
PULSEGRID_MQTT_DEVICE_ID=
PULSEGRID_SIMULATOR_TEMPERATURE_CELSIUS=23.5
