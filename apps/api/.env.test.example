PULSEGRID_ENV=test
PULSEGRID_HTTP_HOST=127.0.0.1
PULSEGRID_HTTP_PORT=18080
PULSEGRID_LOG_LEVEL=warn
PULSEGRID_SHUTDOWN_TIMEOUT=10s
PULSEGRID_IDENTITY_MODE=disabled

# Keep ordinary tests independent of MQTT. The isolated MQTT integration runner
# overrides this with development after it owns the test broker and database.
PULSEGRID_MQTT_INGESTION_MODE=disabled

# Keep ordinary tests independent; the isolated MQTT integration runner owns
# the broker/database before it enables command delivery.
PULSEGRID_MQTT_COMMAND_MODE=disabled

# Isolated disposable test database only; CI/test commands may override this
# process value. Never point test runs at pulsegrid_dev.
PULSEGRID_DATABASE_URL=postgres://pulsegrid:CHANGE_ME@127.0.0.1:15432/pulsegrid_test?sslmode=disable

# Isolated MQTT integration broker for the simulator and API MQTT runtimes.
# Tests must inject their owned canonical device UUID;
# the tracked example intentionally leaves it blank and must never fall back to
# the development broker.
PULSEGRID_MQTT_BROKER_URL=mqtt://127.0.0.1:11883
PULSEGRID_MQTT_TENANT_SLUG=pulsegrid-dev
PULSEGRID_MQTT_DEVICE_ID=
# Select telemetry (one-shot publish) or commands (long-running receiver).
# The isolated MQTT runner supplies a registered device in commands mode.
PULSEGRID_SIMULATOR_MODE=telemetry
# PULSEGRID_SIMULATOR_COMMAND_RESPONSE=success
PULSEGRID_SIMULATOR_TEMPERATURE_CELSIUS=23.5
