PULSEGRID_ENV=test
PULSEGRID_HTTP_HOST=127.0.0.1
PULSEGRID_HTTP_PORT=18080
PULSEGRID_LOG_LEVEL=warn
PULSEGRID_SHUTDOWN_TIMEOUT=10s
PULSEGRID_IDENTITY_MODE=disabled

# Isolated disposable test database only; CI/test commands may override this
# process value. Never point test runs at pulsegrid_dev.
PULSEGRID_DATABASE_URL=postgres://pulsegrid:CHANGE_ME@127.0.0.1:15432/pulsegrid_test?sslmode=disable
