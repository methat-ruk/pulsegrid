PULSEGRID_ENV=development
PULSEGRID_HTTP_HOST=127.0.0.1
PULSEGRID_HTTP_PORT=8080
PULSEGRID_LOG_LEVEL=info
PULSEGRID_SHUTDOWN_TIMEOUT=10s
PULSEGRID_IDENTITY_MODE=development

# Enable the local API MQTT consumer. The broker and database must be running
# before starting the API in this mode.
PULSEGRID_MQTT_INGESTION_MODE=development

# The API resolves the fixed pulsegrid-dev organization at startup. Replace
# CHANGE_ME in the ignored .env.development file with the local disposable
# database password after running migrations and seed.
PULSEGRID_DATABASE_URL=postgres://pulsegrid:CHANGE_ME@127.0.0.1:5432/pulsegrid_dev?sslmode=disable

# The loopback broker URL is shared by the API consumer and MVP-004 simulator.
# The tenant, device, and temperature values remain simulator-only. Set
# PULSEGRID_MQTT_DEVICE_ID in the ignored
# .env.development file to a UUID returned by the registered-device journey.
PULSEGRID_MQTT_BROKER_URL=mqtt://127.0.0.1:1883
PULSEGRID_MQTT_TENANT_SLUG=pulsegrid-dev
PULSEGRID_MQTT_DEVICE_ID=
PULSEGRID_SIMULATOR_TEMPERATURE_CELSIUS=23.5
